# ─────────────────────────────────────────────────────────────
# Stookii — Bakong KHQR payment configuration
#
# To go LIVE: copy this file to ".env.local", fill in the values
# below, and restart the dev server (npm run dev).
#
# Leave these blank to stay in SIMULATION mode — the POS still shows
# a scannable demo QR and you confirm payment with the on-screen
# "Simulate customer payment" button, so you can test everything now.
# ─────────────────────────────────────────────────────────────

# Your Bakong account ID (KHQR receiving account), e.g. "sok_dara@aclb".
# Get it from your bank (ABA, ACLEDA, Wing, etc.) or the Bakong app.
BAKONG_ACCOUNT_ID=

# How your shop name + city appear on the customer's payment screen.
BAKONG_MERCHANT_NAME=Stookii Store
BAKONG_MERCHANT_CITY=Phnom Penh

# Bakong Open API developer token — used to CONFIRM a payment actually
# arrived. Register at https://api-bakong.nbc.gov.kh to get one.
# (Tokens expire ~3 months; renew when payment confirmation stops working.)
BAKONG_API_TOKEN=

# Bakong Open API base URL (only change if NBC moves the endpoint).
BAKONG_API_BASE=https://api-bakong.nbc.gov.kh
