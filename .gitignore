/node_modules
/.next
/out
/build
npm-debug.log*
.DS_Store
*.pem
.env*.local

# Runtime store data — NEVER publish (contains password hashes & live data).
# Keep only the seed master catalog.
/data/stores/
/data/system.json
/data/master-products.json
# Recipes and promotions build themselves from the stores the FIRST time they're
# read, and only when the file is missing. Committing one — even an empty one —
# would land in a deploy where DATA_DIR isn't a disk, suppress that migration
# forever, and let the next sync mirror {} over every store's real recipes.
/data/master-recipes.json
/data/master-promotions.json

# Source spreadsheets & scratch files
*.xlsx
*.log
tmp_*.js
