# --- Stookii environment ---
# Copy the important ones into your hosting provider's "Variables" settings.

# REQUIRED in production. A long random string that signs login sessions.
# Generate one, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# The owner account's password on first launch (username is always "owner").
# Change it after first login. Default is "sekuna2026" if left unset.
OWNER_PASSWORD=sekuna2026

# Where mutable data is stored. On a host with a persistent disk, point this at
# the mounted volume (the Dockerfile defaults it to /data).
DATA_DIR=/data

NODE_ENV=production
